# codec399 server settings. install.sh copies this to /etc/codec399.env on the first run.
# Accounts are not set here: create them with manage.py (see deploy/README.md).
CODEC399_JOBS_DIR=/var/lib/codec399
CODEC399_BEHIND_PROXY=1
CODEC399_MAX_QUEUE=10
# Point at other ffmpeg builds if the distro package is not wanted.
# FFMPEG=/usr/local/bin/ffmpeg
# FFPROBE=/usr/local/bin/ffprobe

# --- Payments (deploy/PAYMENTS.md walks through every value) ---
# Public address of this site; used in the bot's messages and as the page Whop sends people back to.
# CODEC399_PUBLIC_URL=https://ghostrus.xyz
# Whop webhook secret (ws_...), shown in the Secret column after you create the webhook.
# CODEC399_WHOP_WEBHOOK_SECRET=ws_xxxxxxxxxxxxxxxx
# Whop account API key, business id and the product the plans hang off.
# WHOP_API_KEY=xxxxxxxxxxxxxxxx
# WHOP_COMPANY_ID=biz_q8U4sOdwLgmqk5
# WHOP_PRODUCT_ID=prod_obWrOW3bzzOBD
# Optional: an existing $1,500/month plan for Gold instead of one created on the fly.
# WHOP_GOLD_PLAN_ID=plan_xxxxxxxxxxxxxx
# Prices in dollars (defaults shown).
# CODEC399_PRICE_PER_AD=25
# CODEC399_GOLD_PRICE=1500

# --- Discord bot ---
# DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxx
# DISCORD_GUILD_ID=123456789012345678
# DISCORD_TICKET_CATEGORY_ID=123456789012345678
# DISCORD_TICKET_PREFIX=ticket-
# Shared secret between the bot and the app (any long random string): openssl rand -hex 32
# CODEC399_BOT_TOKEN=xxxxxxxxxxxxxxxx
# CODEC399_INTERNAL_URL=http://127.0.0.1:5399
# Optional: a Discord channel webhook URL; every payment is announced there.
# DISCORD_NOTIFY_WEBHOOK=https://discord.com/api/webhooks/...

# --- Meta Media Library ---
# Finished videos are copied into a folder per client in this business's Media Library, shared
# with the Business Portfolio ID the client registered with. See deploy/META_LIBRARY.md.
# META_BUSINESS_ID=123456789012345
# META_ACCESS_TOKEN=xxxxxxxxxxxxxxxx     # System User token: business_management, business_creative_management, ads_management
# META_API_VERSION=v25.0
# META_SHARE_TASKS=MANAGE_CONTENT

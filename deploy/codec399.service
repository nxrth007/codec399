[Unit]
Description=codec399 video re-encoder (gunicorn)
After=network.target

[Service]
User=codec399
Group=codec399
WorkingDirectory=/opt/codec399
EnvironmentFile=/etc/codec399.env
# Exactly one worker: the job table and queue live in process memory.
ExecStart=/opt/codec399/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 600 \
    --bind 127.0.0.1:5399 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=3
TimeoutStopSec=30
# The encoder saturates every core; keep SSH and nginx responsive.
Nice=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/codec399 /opt/codec399

[Install]
WantedBy=multi-user.target
